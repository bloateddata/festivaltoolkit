<Project>

  <!-- Central Package Management: jede Fremdversion an genau einer Stelle.
       Siehe docs/19-build.md, Teil 1. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Zieht auch transitive Abhängigkeiten auf die hier festgelegte Version.
         Das ist der Hebel, wenn eine Lücke in einem Paket steckt, das wir
         selbst gar nicht referenzieren. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Gilt für jedes Projekt, ohne dass es dort steht. -->
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="7.0.0" />
  </ItemGroup>

  <!-- Test. Lizenzlage geprüft, siehe docs/16-open-source.md und docs/23, Teil 5:
       FluentAssertions ist ab v8 kostenpflichtig, deshalb Shouldly (BSD). -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

</Project>
