<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> ist Absicht: ohne das erben Builds die Quellen aus der
       Maschinenkonfiguration, und dann ist unklar, woher ein Paket stammt.
       Siehe docs/19-build.md, Teil 5. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Package Source Mapping gegen Dependency Confusion. Sobald ein zweiter Feed
       hinzukommt, muss FestivalToolkit.* dort explizit zugeordnet werden. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
