<Project>

  <!-- Nachgelagerte Vorgaben. Siehe docs/19-build.md, Teil 1 und Teil 6. -->

  <!-- Eine Version für das ganze Repository, abgeleitet aus dem Git-Tag (docs/19, Teil 3).
       Das Paket selbst kommt als GlobalPackageReference aus Directory.Packages.props. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!-- Container ohne Dockerfile: gilt für jedes ausführbare Projekt (docs/19, Teil 6). -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' AND '$(IsTestProject)' != 'true'">
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled</ContainerBaseImage>
    <ContainerUser>app</ContainerUser>
    <ContainerRepository>$(MSBuildProjectName.ToLowerInvariant())</ContainerRepository>
  </PropertyGroup>

  <!-- Die Wurzel-README liegt jedem Paket bei; ohne sie schlägt pack fehl,
       weil PackageReadmeFile in Directory.Build.props gesetzt ist. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Testprojekte werden nie gepackt und brauchen keine Paketmetadaten. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

</Project>
